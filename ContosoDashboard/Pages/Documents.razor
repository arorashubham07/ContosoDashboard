@page "/documents"
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Security.Claims

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid document-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Documents</h1>
    </div>

    <section class="mb-4" aria-labelledby="upload-heading">
        <h2 id="upload-heading" class="h4">Upload document</h2>
        <div class="row g-3">
            <div class="col-md-5"><label class="form-label" for="document-title">Title</label><input id="document-title" class="form-control" @bind="title" /></div>
            <div class="col-md-4"><label class="form-label" for="document-category">Category</label><select id="document-category" class="form-select" @bind="category">@foreach (var option in categories) { <option value="@option">@option</option> }</select></div>
            <div class="col-md-3"><label class="form-label" for="document-file">File</label><InputFile id="document-file" OnChange="SelectFile" /></div>
        </div>
        <div class="mt-3"><button class="btn btn-primary" @onclick="UploadAsync" disabled="@(selectedFile is null || uploading)">@(uploading ? "Uploading..." : "Upload")</button></div>
        @if (!string.IsNullOrWhiteSpace(outcome)) { <div class="alert @(uploadSucceeded ? "alert-success" : "alert-danger") mt-3" role="status">@outcome</div> }
    </section>

    <section aria-labelledby="my-documents-heading">
        <h2 id="my-documents-heading" class="h4">My Documents</h2>
        @if (documents is null) { <p>Loading...</p> }
        else if (documents.Count == 0) { <p class="text-muted">No documents have been uploaded.</p> }
        else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th></th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@document.Title</td><td>@document.Category</td><td>@document.UploadedAtUtc.ToLocalTime().ToString("d")</td><td>@document.FileSizeBytes.ToString("N0") bytes</td><td>@(document.Project?.Name ?? "Personal")</td><td><a class="btn btn-sm btn-outline-primary" href="/documents/@document.DocumentId/download">Download</a></td></tr> }</tbody></table></div> }
    </section>
</div>

@code {
    private static readonly string[] categories = ["Project Documents", "Team Resources", "Personal Files", "Reports", "Presentations", "Other"];
    private IBrowserFile? selectedFile;
    private List<Document>? documents;
    private string title = string.Empty;
    private string category = "Personal Files";
    private string? outcome;
    private bool uploadSucceeded;
    private bool uploading;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
        documents = (await DocumentService.GetMyDocumentsAsync(currentUserId)).ToList();
    }

    private void SelectFile(InputFileChangeEventArgs args) => selectedFile = args.File;

    private async Task UploadAsync()
    {
        if (selectedFile is null || currentUserId == 0) return;
        uploading = true;
        await using var stream = selectedFile.OpenReadStream(25_000_001);
        var result = await DocumentService.UploadAsync(new(currentUserId, title, category, null, null, null, selectedFile.Name, selectedFile.ContentType, stream));
        uploadSucceeded = result.Succeeded;
        outcome = result.Succeeded ? "Document uploaded." : result.Error;
        if (result.Succeeded) { selectedFile = null; title = string.Empty; documents = (await DocumentService.GetMyDocumentsAsync(currentUserId)).ToList(); }
        uploading = false;
    }
}